<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="freehand"
        Arguments=""
        InstallLocation="C:\Program Files\tnware\Freehand">
    </Installer>
    <PackageInformation
        PackageName="Freehand"
        PackageDisplayName="Freehand"
        PublisherName="CN=tnware"
        PublisherDisplayName="tnware"
        Version="0.1.0.1"
        PackageDescription="Speech to text, anywhere you type.">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.tnware.freehand"
                Description="Speech to text, anywhere you type."
                DisplayName="Freehand"
                ExecutableName="freehand"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Freehand</DisplayName>
            <PublisherDisplayName>tnware</PublisherDisplayName>
            <Description>Speech to text, anywhere you type.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="freehand.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
