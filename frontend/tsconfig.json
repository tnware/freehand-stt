{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "$lib/*": ["./src/lib/*"],
      "$bindings/*": [
        "./bindings/github.com/tnware/freehand-stt/internal/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "bindings"]
}
