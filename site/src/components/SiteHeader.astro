---
import mark from "../assets/freehand-mark.svg";

interface Props {
  current?: "home" | "download";
}

const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---

<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={href("/")} aria-label="Freehand home">
      <img src={mark.src} alt="" />
      <span>Freehand</span>
    </a>

    <nav aria-label="Primary navigation">
      <a href={href("/#workflow")}>How it works</a>
      <a href={href("/#principles")}>Privacy</a>
      <a href={href("/docs/getting-started/")}>Docs</a>
      <a href={href("/download/")} aria-current={current === "download" ? "page" : undefined}>Download</a>
    </nav>

    <span class="github-control">
      <a
        class="github-repo-link"
        href="https://github.com/tnware/freehand-stt"
        target="_blank"
        rel="noreferrer"
        aria-label="Star Freehand on GitHub"
      >
        <svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m12 2.5 2.84 5.76 6.36.92-4.6 4.49 1.09 6.33L12 17.01 6.31 20l1.09-6.33-4.6-4.49 6.36-.92L12 2.5Z"/></svg>
        <span class="github-repo-label">Star</span>
      </a>
      <a
        class="github-count-link"
        href="https://github.com/tnware/freehand-stt/stargazers"
        target="_blank"
        rel="noreferrer"
        aria-label="View Freehand stargazers"
        data-star-count
      >—</a>
    </span>

    <a class="header-cta" href={href("/download/")} aria-current={current === "download" ? "page" : undefined}>
      <span class="header-cta-label">Download</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"/></svg>
    </a>
  </div>
</header>

<script>
  const count = document.querySelector<HTMLElement>("[data-star-count]");

  if (count) {
    fetch("https://api.github.com/repos/tnware/freehand-stt", {
      headers: { Accept: "application/vnd.github+json" },
    })
      .then((response) => response.ok ? response.json() : Promise.reject())
      .then((repository: { stargazers_count?: number }) => {
        if (typeof repository.stargazers_count !== "number") return;
        count.textContent = new Intl.NumberFormat("en", { notation: "compact" }).format(repository.stargazers_count);
      })
      .catch(() => {
        // "Star" remains a useful action when the repository is private,
        // GitHub is unavailable, or the anonymous API limit is exhausted.
      });
  }
</script>
