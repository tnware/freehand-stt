---
import wallpaper from "../assets/demo-desktop-wallpaper.svg";
interface Props { realtime?: boolean }
const { realtime = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Illustrative scene, not a native capture. Capsule geometry and stage treatment
// reference internal/platform/overlay_darwin.m; no microphone or network access.
const transcript = [
  "Start with a small idea.",
  realtime ? "Build something useful, then take a moment to try it out." : "Make something useful, then try it out.",
  "Keep what works. Leave the rest.",
].join("\n\n");
---
<freehand-dictation-demo data-realtime={String(realtime)} data-phase="done" data-paused="true">
  <div class="dictation-desktop" role="img" aria-label={realtime ? "Illustrative macOS desktop: live words appear in Freehand’s caption strip while recording. Only finalized text enters the same focused document after recording stops." : "Illustrative macOS desktop: Freehand records speech, processes it, then inserts the completed text into the same focused document window."}>
    <div class="desktop-art" aria-hidden="true">
      <div class="desktop-wallpaper" style={{ backgroundImage: `url("${wallpaper.src}")` }}></div>
      <div class="desktop-menubar"><span class="desktop-system-mark">●</span><strong>TextEdit</strong><span>File</span><span>Edit</span><span>Format</span><span>View</span><span>Window</span><span class="desktop-menu-right">Sun 10:24 AM</span></div>
      <div class="demo-document">
        <div class="document-titlebar"><span class="window-controls"><i></i><i></i><i></i></span><span>Getting started</span><span class="document-file-mark">⌄</span></div>
        <div class="document-toolbar"><span>Body</span><span class="toolbar-divider"></span><span>Helvetica</span><span class="font-size">14</span><span class="toolbar-divider"></span><b>B</b><em>I</em><u>U</u><span class="document-align">☰</span></div>
        <div class="document-paper">
          <div class="document-heading">A few thoughts</div>
          <p class="dictated-paragraph"><span data-demo-text data-transcript={transcript}>{transcript}</span><span class="document-caret"></span></p>
        </div>
      </div>
      <div class="demo-overlay">
        <svg viewBox={`0 0 ${realtime ? 340 : 208} 54`} fill="none">
          <rect class="overlay-surface" x=".5" y=".5" width={realtime ? 339 : 207} height="53" rx="26.5"/>
          <g class="overlay-mic" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="27" y="16" width="9" height="15" rx="4.5" fill="currentColor" stroke="none"/><path d="M23.5 26v1a8 8 0 0 0 16 0v-1M31.5 35v5m-4 0h8"/></g>
          <g class="overlay-spinner" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="32" cy="27" r="8" opacity=".25"/><path d="M32 19a8 8 0 0 1 8 8"/></g>
          <path class="overlay-check" d="m25 27 5 5 10-11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          {!realtime && <path d="M57 17v20" stroke="#8697ad" stroke-opacity=".2"/>}
          <g class="overlay-wave" fill="currentColor">{Array.from({ length: 17 }, (_, i) => <rect data-wave-bar x={73 + i * 6.7} y="25.5" width="3.6" height="3" rx="1.8" />)}</g>
          <g class="overlay-progress"><rect x="73" y="25" width="112" height="4" rx="2" fill="currentColor" opacity=".18"/><rect class="progress-segment" x="73" y="25" width="34" height="4" rx="2" fill="currentColor"/></g>
          <path class="overlay-finish" d="M73 27h110" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        {realtime && <div class="overlay-live-caption"><span data-live-caption>Listening…</span></div>}
      </div>
    </div>
  </div>
  <div class="demo-caption"><span><span data-demo-status>Text inserted</span><span class="demo-disclaimer"> · Illustrative demo</span></span><div class="demo-actions" hidden><button type="button" data-demo-toggle>Pause</button><button type="button" data-demo-replay aria-label="Replay dictation demo">Replay ↻</button></div></div>
  {realtime && <p class="realtime-note">Requires a supported model and backend. <a href={`${base}/docs/guides/live-transcription/`}>Live transcription setup ↗</a></p>}
</freehand-dictation-demo>
<style>
  freehand-dictation-demo { display: block; min-width: 0; }
  .dictation-desktop { container-type: inline-size; position: relative; aspect-ratio: 680 / 450; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 8px; background: #254351; box-shadow: 0 22px 65px rgb(0 0 0 / 24%); }
  .desktop-art { position: absolute; inset: 0; color: #e5e5e7; color-scheme: dark; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 1.8cqw; line-height: 1.5; }
  .desktop-wallpaper { position: absolute; inset: 0; background-color: #121e3c; background-size: cover; background-position: center; }
  .desktop-menubar { position: absolute; inset: 0 0 auto; height: 4.4cqw; display: flex; align-items: center; gap: 2.2cqw; padding-inline: 2.3cqw; background: rgb(17 33 47 / 62%); color: #f3f5f8; font-size: 1.55cqw; }
  .desktop-system-mark { font-size: 1.8cqw; }
  .desktop-menu-right { margin-left: auto; font-variant-numeric: tabular-nums; }
  .demo-document { position: absolute; inset: 10cqw 7.5cqw 15cqw; border: 1px solid #5a5a5e; border-radius: 1.3cqw; overflow: hidden; background: #202022; box-shadow: 0 2cqw 6cqw #080b125e, 0 0 0 1px #080a1055; }
  .document-titlebar { height: 5cqw; display: flex; align-items: center; justify-content: center; gap: .8cqw; background: #373739; border-bottom: 1px solid #454548; font-size: 1.65cqw; font-weight: 600; }
  .window-controls { position: absolute; left: 2cqw; display: flex; gap: 1cqw; }
  .window-controls i { width: 1.6cqw; height: 1.6cqw; border: 1px solid #00000014; border-radius: 50%; background: #ff6058; }
  .window-controls i:nth-child(2) { background: #febc2e; }
  .window-controls i:nth-child(3) { background: #28c840; }
  .document-file-mark { color: #b1b1b8; }
  .document-toolbar { display: flex; align-items: center; gap: 2.1cqw; height: 4.6cqw; padding-inline: 2.4cqw; border-bottom: 1px solid #414144; background: #2d2d30; color: #ccccd2; font-size: 1.5cqw; }
  .toolbar-divider { height: 1.8cqw; width: 1px; background: #535358; }
  .font-size { margin-left: 3cqw; }
  .document-align { margin-left: auto; }
  .document-paper { padding: 3.8cqw 4.8cqw; font-size: 2.1cqw; }
  .document-heading { margin-bottom: 2.1cqw; font-size: 3.2cqw; font-weight: 650; letter-spacing: -.08cqw; }
  .document-paper p { margin: 0 0 2cqw; line-height: 1.65; }
  .dictated-paragraph { white-space: pre-line; }
  .document-caret { display: inline-block; width: 1.5px; height: 1.18em; vertical-align: -.2em; margin-left: 1px; background: #82b1ff; }
  .demo-overlay { position: absolute; width: 30.6cqw; height: 7.95cqw; left: 50%; bottom: 3.7cqw; transform: translateX(-50%); color: #91baff; filter: drop-shadow(0 1cqw 1.5cqw #07101b66); transition: opacity .25s; }
  .demo-overlay svg { width: 100%; height: 100%; }
  [data-realtime="true"] .demo-overlay { width: 50cqw; }
  freehand-dictation-demo[data-realtime="true"] .overlay-wave, freehand-dictation-demo[data-realtime="true"] .overlay-progress, freehand-dictation-demo[data-realtime="true"] .overlay-finish { display: none; }
  .overlay-live-caption { position: absolute; left: 8.5cqw; right: 2.6cqw; top: 0; height: 100%; display: flex; align-items: center; overflow: hidden; white-space: nowrap; color: #f1f4fa; font-size: 2.05cqw; }
  [data-live-caption] { flex: none; }
  .realtime-note { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.65; }
  .realtime-note a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .overlay-surface { fill: #151d2bf5; stroke: #7ca9e354; }
  .overlay-spinner, .overlay-check, .overlay-progress, .overlay-finish { display: none; }
  [data-phase="processing"] .overlay-spinner { display: block; transform-origin: 32px 27px; animation: demo-spin 1.2s linear infinite; }
  [data-phase="processing"] .overlay-progress, [data-phase="inserting"] .overlay-progress { display: block; }
  [data-phase="processing"] .overlay-mic, [data-phase="inserting"] .overlay-mic, [data-phase="done"] .overlay-mic,
  [data-phase="processing"] .overlay-wave, [data-phase="inserting"] .overlay-wave, [data-phase="done"] .overlay-wave { display: none; }
  [data-phase="inserting"] .overlay-check, [data-phase="done"] .overlay-check, [data-phase="done"] .overlay-finish { display: block; }
  [data-phase="done"] .demo-overlay { opacity: 0; }
  [data-phase="processing"] .progress-segment, [data-phase="inserting"] .progress-segment { animation: demo-progress 1.4s ease-in-out infinite alternate; }
  [data-paused="true"] .overlay-spinner, [data-paused="true"] .progress-segment { animation-play-state: paused; }
  .demo-caption { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 12px; }
  [data-demo-status] { color: var(--muted-strong); }
  .demo-actions { display: flex; gap: 14px; }
  .demo-actions[hidden] { display: none; }
  .demo-actions button { padding: 0; min-height: 44px; background: none; border: none; color: var(--muted); font: inherit; cursor: pointer; }
  .demo-actions button:hover { color: white; }
  .demo-actions button:disabled { opacity: .45; cursor: default; }
  @keyframes demo-spin { to { transform: rotate(360deg); } }
  @keyframes demo-progress { to { transform: translateX(78px); } }
  @media (prefers-reduced-motion: reduce) { .demo-overlay { transition: none; } .overlay-spinner, .progress-segment { animation: none !important; } }
  @media (max-width: 400px) { .demo-caption { gap: 6px; font-size: 11px; } .demo-actions { gap: 10px; } }
</style>
<script>
  class FreehandDictationDemo extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      this.cleanup?.();
      const text = this.querySelector<HTMLElement>("[data-demo-text]");
      const status = this.querySelector<HTMLElement>("[data-demo-status]");
      const toggle = this.querySelector<HTMLButtonElement>("[data-demo-toggle]");
      const replay = this.querySelector<HTMLButtonElement>("[data-demo-replay]");
      const actions = this.querySelector<HTMLElement>(".demo-actions");
      if (!text || !status || !toggle || !replay || !actions) return;
      const transcript = text.dataset.transcript ?? "";
      const sentences = transcript.split("\n\n");
      const realtime = this.dataset.realtime === "true";
      const caption = this.querySelector<HTMLElement>("[data-live-caption]");
      const captionViewport = this.querySelector<HTMLElement>(".overlay-live-caption");
      const recordingMS = realtime ? 2400 : 1600;
      const processingMS = realtime ? 150 : 650;
      const insertionMS = realtime ? 180 : 500;
      const cycleMS = recordingMS + processingMS + insertionMS + 1200;
      const durationMS = cycleMS * sentences.length + 1800;
      const bars = this.querySelectorAll<SVGRectElement>("[data-wave-bar]");
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      const listeners = new AbortController();
      const options = { signal: listeners.signal };
      let elapsed = reduced.matches ? durationMS - 1 : 0;
      let paused = reduced.matches;
      let visible = false;
      let frame = 0;
      let previous = 0;
      const render = () => {
        const sentenceIndex = Math.min(sentences.length - 1, Math.floor(elapsed / cycleMS));
        const localMS = elapsed - sentenceIndex * cycleMS;
        const insertionStart = recordingMS + processingMS;
        const phase = localMS < recordingMS ? "recording" : localMS < insertionStart ? "processing" : localMS < insertionStart + insertionMS ? "inserting" : "done";
        this.dataset.phase = phase;
        // Completed dictation: nothing enters the document before processing.
        const sentence = sentences[sentenceIndex];
        const length = Math.max(0, Math.min(sentence.length, Math.floor((localMS - insertionStart) / insertionMS * sentence.length)));
        const completed = sentences.slice(0, sentenceIndex);
        text.textContent = [...completed, sentence.slice(0, length)].join("\n\n");
        status.textContent = { recording: realtime ? "Live transcription" : "Recording", processing: realtime ? "Finalizing" : "Transcribing", inserting: "Inserting text", done: "Text inserted" }[phase];
        if (caption && captionViewport) {
          const words = sentence.split(" ");
          const count = Math.min(words.length, Math.floor(Math.max(0, localMS - 200) / (recordingMS - 450) * words.length));
          const preview = words.slice(0, count).join(" ") || "Listening…";
          if (caption.textContent !== preview) {
            caption.textContent = preview;
            // Match the native latest-text strip, not an endlessly cycling marquee.
            captionViewport.scrollLeft = captionViewport.scrollWidth;
          }
        }
        toggle.textContent = paused ? "Resume" : "Pause";

        if (phase === "recording") bars.forEach((bar, index) => {
          const envelope = Math.pow(Math.sin((index + 1) / 18 * Math.PI), 1.4);
          const height = 3 + envelope * (7 + 13 * Math.abs(Math.sin(elapsed / 240 + index * .63)));
          bar.setAttribute("height", String(height));
          bar.setAttribute("y", String(27 - height / 2));
        });
      };
      const tick = (now: number) => {
        elapsed = (elapsed + (previous ? Math.min(now - previous, 100) : 0)) % durationMS;
        previous = now;
        render();
        frame = requestAnimationFrame(tick);
      };
      const sync = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        previous = 0;
        const running = visible && !document.hidden && !paused;
        this.dataset.paused = String(!running);
        if (running) frame = requestAnimationFrame(tick);
      };
      toggle.addEventListener("click", () => { paused = !paused; render(); sync(); }, options);
      replay.addEventListener("click", () => { elapsed = 0; paused = false; render(); sync(); }, options);
      document.addEventListener("visibilitychange", sync, options);
      reduced.addEventListener("change", () => {
        if (reduced.matches) { elapsed = durationMS - 1; paused = true; }
        render(); sync();
      }, options);
      const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { threshold: .15 });
      observer.observe(this);
      actions.hidden = false;
      render();
      this.cleanup = () => { listeners.abort(); observer.disconnect(); cancelAnimationFrame(frame); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get("freehand-dictation-demo")) customElements.define("freehand-dictation-demo", FreehandDictationDemo);
</script>
