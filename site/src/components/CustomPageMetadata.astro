---
import { productionUrl } from "../../site-url.mjs";

interface Props {
  title: string;
  description: string;
  path: "" | "download/" | "backends/";
}

const { title, description, path } = Astro.props;
const canonical = new URL(path, productionUrl).href;
const image = new URL("social/freehand.jpg", productionUrl).href;
const imageAlt = "Freehand logo and the tagline: Speech to text, anywhere you type.";
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Freehand" />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
