---
import mark from "../assets/freehand-mark.svg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div><a class="wordmark" href={href("/")}><img src={mark.src} alt="" /><span>Freehand</span></a><p>Free & open source · Windows & macOS</p></div>
    <nav aria-label="Footer navigation">
      <a href={href("/privacy/")}>Privacy & safety</a>
      <a href={href("/docs/getting-started/")}>Documentation</a>
      <a href={href("/docs/reference/provider-icons/")}>Asset credits</a>
      <a href="https://github.com/tnware/freehand-stt">GitHub ↗</a>
    </nav>
  </div>
</footer>
