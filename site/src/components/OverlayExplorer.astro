---
import wallpaper from "../assets/demo-desktop-wallpaper.svg";
// Illustrative layout examples grounded in OverlaySection and the native renderer.
const layouts = [
  { id: "minimal", label: "Minimal", width: 54, height: 54 },
  { id: "capsule", label: "Capsule", width: 208, height: 54 },
  { id: "meter", label: "Meter", width: 280, height: 64 },
  { id: "detailed", label: "Detailed", width: 280, height: 152 },
];
const positions = ["Top left", "Top center", "Top right", "Bottom left", "Bottom center", "Bottom right"];
---
<freehand-overlay-explorer>
  <div class="overlay-stage" style={{ backgroundImage: `url("${wallpaper.src}")` }}>
    <span class="stage-label">Overlay appearance</span>
    <div class="overlay-anchor" data-position="bottom-center">
      {layouts.map(layout => <svg class="overlay-example" data-layout-panel={layout.id} hidden={layout.id !== "capsule"} style={{ width: `${layout.width / 6.8}cqw` }} viewBox={`0 0 ${layout.width} ${layout.height}`} role="img" aria-label={`${layout.label} recording overlay illustration`}>
        <rect x="1" y="1" width={layout.width - 2} height={layout.height - 2} rx={layout.id === "detailed" ? 18 : 26} fill="#151d2b" stroke="#7ca9e354"/>
        <g transform={`translate(${layout.id === "minimal" ? -5 : 0} ${layout.id === "detailed" ? 0 : (layout.height - 54) / 2})`} fill="none" stroke="#91baff" stroke-width="1.8" stroke-linecap="round">
          <rect x="27" y="16" width="9" height="15" rx="4.5" fill="#91baff" stroke="none"/>
          <path d="M23.5 26v1a8 8 0 0 0 16 0v-1M31.5 35v5m-4 0h8"/>
          {layout.id === "minimal" && <circle cx="32" cy="27" r="20" opacity=".35"/>}
        </g>
        {layout.id === "meter" && <text x="54" y="23" fill="#f5f7fb" font-size="12" font-weight="600">Recording</text>}
        {layout.id === "detailed" && <g fill="#f5f7fb"><text x="54" y="24" font-size="10" opacity=".76">FREEHAND</text><text x="54" y="45" font-size="17" font-weight="600">Recording</text><text x="18" y="73" font-size="12" opacity=".76">Press shortcut to finish</text><text x="18" y="94" font-size="11">Your recording shortcut</text><text x="18" y="137" font-size="11" opacity=".76">00:04</text></g>}
        {layout.id !== "minimal" && <g fill="#91baff">{Array.from({ length: 17 }, (_, i) => {
          const height = 3 + Math.sin((i + 1) / 18 * Math.PI) ** 2 * (i % 3 === 0 ? 17 : 11);
          const x = layout.id === "detailed" ? 18 : 56;
          const width = layout.width - x - 20;
          const y = layout.id === "detailed" ? 112 : layout.id === "meter" ? 42 : 27;
          return <rect x={x + i * width / 17} y={y - height / 2} width={Math.max(2, width / 17 - 3)} height={height} rx="2"/>;
        })}</g>}
      </svg>)}
    </div>
  </div>
  <div class="explorer-controls" hidden>
    <div class="layout-choices" role="group" aria-label="Example overlay layout">{layouts.map(layout => <button type="button" data-layout={layout.id} aria-pressed={String(layout.id === "capsule")}>{layout.label}</button>)}</div>
    <label>Position <select data-position-control>{positions.map(position => <option value={position.toLowerCase().replaceAll(" ", "-")} selected={position === "Bottom center"}>{position}</option>)}</select></label>
  </div>
  <p class="explorer-caption">Illustrative preview. Adjust the real overlay in Settings → Overlay.</p>
</freehand-overlay-explorer>
<style>
  freehand-overlay-explorer { display: block; min-width: 0; }
  .overlay-stage { container-type: inline-size; position: relative; aspect-ratio: 680 / 360; overflow: hidden; background-color: #121e3c; background-position: center; background-size: cover; border: 1px solid var(--line-strong); border-radius: 8px; }
  .stage-label { position: absolute; top: 18px; left: 20px; color: var(--muted-strong); font-size: 11px; letter-spacing: .02em; }
  .overlay-anchor { position: absolute; inset: 10cqw 4cqw 4cqw; display: flex; align-items: end; justify-content: center; pointer-events: none; }
  .overlay-anchor[data-position^="top"] { align-items: start; }
  .overlay-anchor[data-position$="left"] { justify-content: start; }
  .overlay-anchor[data-position$="right"] { justify-content: end; }
  .overlay-example { flex: none; height: auto; filter: drop-shadow(0 8px 14px #080c2077); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  .overlay-example[hidden] { display: none; }
  .explorer-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-top: 10px; }
  .explorer-controls[hidden] { display: none; }
  .layout-choices { display: flex; flex-wrap: wrap; gap: 14px; }
  .layout-choices button { min-height: 44px; padding: 7px 0; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--muted); font-size: 12px; }
  .layout-choices button[aria-pressed="true"] { color: var(--ink); border-bottom-color: var(--accent); }
  label { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 12px; }
  select { min-height: 44px; max-width: 170px; border: 1px solid var(--line); border-radius: 5px; background: var(--surface); color: var(--ink); padding: 7px 10px; font-size: 12px; }
  .explorer-caption { color: var(--muted); font-size: 11px; margin: 12px 0 0; }
</style>
<script>
  class FreehandOverlayExplorer extends HTMLElement {
    private listeners?: AbortController;
    connectedCallback() {
      this.listeners?.abort();
      this.listeners = new AbortController();
      const options = { signal: this.listeners.signal };
      const controls = this.querySelector<HTMLElement>(".explorer-controls");
      const anchor = this.querySelector<HTMLElement>(".overlay-anchor");
      const position = this.querySelector<HTMLSelectElement>("[data-position-control]");
      if (!controls || !anchor || !position) return;
      controls.hidden = false;
      this.querySelectorAll<HTMLButtonElement>("[data-layout]").forEach(button => {
        button.addEventListener("click", () => {
          this.querySelectorAll<SVGElement>("[data-layout-panel]").forEach(panel => { panel.toggleAttribute("hidden", panel.dataset.layoutPanel !== button.dataset.layout); });
          this.querySelectorAll("[data-layout]").forEach(item => item.setAttribute("aria-pressed", String(item === button)));
        }, options);
      });
      position.addEventListener("change", () => { anchor.dataset.position = position.value; }, options);
    }
    disconnectedCallback() { this.listeners?.abort(); }
  }
  if (!customElements.get("freehand-overlay-explorer")) customElements.define("freehand-overlay-explorer", FreehandOverlayExplorer);
</script>
