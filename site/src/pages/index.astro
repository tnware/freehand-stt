---
import ProductLayout from "../layouts/ProductLayout.astro";
import AppPreview from "../components/AppPreview.astro";
import ProviderIcon from "../components/ProviderIcon.astro";
import { availableBackends } from "../data/backends";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const capabilities = [
  { title: "Transcription", feature: "microphone", description: "Dictate into an app with a shortcut, or select an audio file and copy the result. Use completed transcription or live dictation with a qualified model.", detail: "Microphone & audio files · Optional live captions", guide: "/docs/guides/using-freehand/", link: "Transcription guide" },
  { title: "Transcript cleanup", feature: "cleanup", description: "Process completed transcripts with a separate chat model. Use custom instructions or S1-mini’s English controls; raw text remains the fallback if cleanup fails.", detail: "Optional stage · Separate connection & model", guide: "/docs/guides/post-processing/", link: "Cleanup guide" },
  { title: "Text to speech", feature: "playback", description: "Enter text, generate audio, then listen or save it. Choose a voice and adjust the speaking options supported by the server and model.", detail: "Playback & export · Independent of dictation", guide: "/docs/getting-started/#generate-speech", link: "Speech setup" },
] as const;
---
<ProductLayout current="home" title="Freehand — Speech tools for Windows and macOS" description="Dictate into apps, transcribe audio files, and generate speech. A native Windows and macOS client for local, network, and hosted speech services.">
  <section class="compact-hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow"><span>Windows & macOS</span><span>Free & open source</span></p>
      <h1 id="hero-title">Speech tools<br /><span>for your desktop.</span></h1>
      <p class="lede">Dictate into apps, transcribe audio files, and generate speech. Install a supported local runtime in Freehand, or connect a service of your own.</p>
      <div class="actions">
        <a class="button" data-home-download href={href("/download/")}>Choose your download →</a>
        <a class="text-link" href={href("/docs/getting-started/")}>Setup guide →</a>
      </div>
      <p class="fine-print">Windows 11 x64 · macOS 13+<br />Local runtimes and models download only when you choose.</p>
    </div>
    <AppPreview />
  </section>
  <section class="product-section setup-options" aria-label="Choose your setup">
    <article>
      <h2>Run locally, set up in Freehand</h2>
      <p>Install NeMo for live dictation with Nemotron or completed transcription with Parakeet. Add llama.cpp with S1-mini for English cleanup. Windows also supports managed whisper.cpp.</p>
      <a class="text-link" href={href("/docs/guides/local-runtime/")}>Set up a local runtime →</a>
    </article>
    <article>
      <h2>Connect your own service</h2>
      <p>Use an existing server on this computer, on your network, or with a hosted provider. Choose each task’s connection independently, including text to speech, which needs a separately configured service.</p>
      <a class="text-link" href={href("/docs/guides/connect-a-server/")}>Connect a service →</a>
    </article>
  </section>
  <section class="product-section" aria-labelledby="capabilities-title">
    <div class="section-heading">
      <div><h2 id="capabilities-title">Capabilities & backends</h2><p>Choose connections independently for Voice, audio files, cleanup, and speech generation.</p></div>
      <a class="text-link" href={href("/backends/")}>Compare support →</a>
    </div>
    <div class="capability-grid">
      {capabilities.map((capability) => <article class="capability-panel">
        <h3>{capability.title}</h3>
        <p>{capability.description}</p>
        <div class="capability-detail">{capability.detail}</div>
        <ul class="provider-links" aria-label={`${capability.title} backends`}>
          {availableBackends.filter((backend) => backend.features[capability.feature] === "available").map((backend) => <li><a href={href(backend.guide)}><ProviderIcon profile={backend.id} size={30} /><span>{backend.name}</span><span aria-hidden="true">↗</span></a></li>)}
        </ul>
        <a class="text-link" href={href(capability.guide)}>{capability.link} →</a>
      </article>)}
    </div>
    <p class="fine-print">Your installed release may have fewer profiles than those listed here. Capabilities depend on the server version and <a class="text-link" href={href("/models/")}>model profile →</a></p>
  </section>
  <section class="platform-section product-section" aria-labelledby="desktop-title">
    <div><h2 id="desktop-title">Native desktop integration</h2><p>Global shortcuts, microphone capture, and a passive status overlay. Dictation is delivered only while the original app and window remain valid and focused; otherwise the result stays ready to copy.</p><a class="text-link" href={href("/privacy/")}>Privacy & safety →</a></div>
    <div class="platform-details">
      <article><h3>Windows</h3><p>Windows 11, x64. Saved keys use Credential Manager. Choose an installer or a portable build.</p><a class="text-link" href={href("/docs/guides/windows-installer/")}>Windows installation →</a></article>
      <article><h3>macOS</h3><p>macOS 13+, Apple Silicon or Intel. Saved keys use Keychain. Microphone and keyboard access are granted through system permissions.</p><a class="text-link" href={href("/docs/guides/macos-setup/")}>macOS setup →</a></article>
    </div>
  </section>
  <script>
    import { enhanceDownloads } from "../lib/downloads-client.mjs";
    enhanceDownloads();
  </script>
</ProductLayout>
