---
import ProductLayout from "../layouts/ProductLayout.astro";
import OverlayExplorer from "../components/OverlayExplorer.astro";
import FeatureIcon from "../components/FeatureIcon.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const recording = [
  { title: "Toggle or hold to talk", description: "Press a shortcut to start and stop, or hold it while speaking. Choose your microphone and recording limit independently.", link: "Recording controls", path: "/docs/guides/using-freehand/#voice-dictation" },
  { title: "Speech detection", description: "Trim silence, stop toggle recordings after a pause, or split longer recordings at checkpoints. These controls apply to completed dictation, not realtime.", link: "Speech detection", path: "/docs/guides/using-freehand/#long-dictation-and-vad" },
  { title: "Shared vocabulary", description: "Keep names and specialist terms in one list for Voice and audio files. Supported models receive them as recognition hints, not guaranteed corrections.", link: "Vocabulary support", path: "/docs/guides/vocabulary/" },
];
const results = [
  { title: "Current result & recovery", description: "Copy a completed transcript without enabling history. If the original destination is no longer safe for insertion, the result stays available for explicit copy.", link: "Results and delivery", path: "/docs/guides/using-freehand/#current-result-and-task-settings" },
  { title: "Optional session history", description: "Revisit recent transcripts and compare raw and cleaned versions. History is off by default, stays in memory, and clears when you quit. It never retains audio.", link: "History details", path: "/docs/guides/using-freehand/#history" },
  { title: "Files & speech playback", description: "Transcribe an audio file without a microphone shortcut. With text to speech enabled, listen to results or generate and save speech from text you enter.", link: "File and speech workflows", path: "/docs/guides/using-freehand/#audio-files" },
];
---
<ProductLayout current="features" path="features/" title="Features — Freehand" description="Explore Freehand’s customizable overlay, recording controls, vocabulary, transcript recovery, and optional session history.">
  <header class="page-heading">
    <h1>Features</h1>
    <p class="lede">Set your recording shortcuts, customize the overlay, and keep completed transcripts ready to copy.</p>
  </header>
  <section class="overlay-feature" aria-labelledby="overlay-title">
    <div class="overlay-copy">
      <h2 id="overlay-title">Customize the overlay</h2>
      <p>See recording and processing status without bringing the main window forward. The native overlay stays out of the way of your clicks and typing.</p>
      <dl>
        <div><dt><span class="overlay-setting-icon"><FeatureIcon name="layout" /></span>Layout, position & size</dt><dd>Choose Minimal, Capsule, Meter, or Detailed, then adjust its screen position and scale.</dd></div>
        <div><dt><span class="overlay-setting-icon"><FeatureIcon name="appearance" /></span>Appearance & behavior</dt><dd>Adjust the surface, visualizer, opacity, glow, motion, and which phases are visible. Or turn the overlay off.</dd></div>
        <div><dt><span class="overlay-setting-icon"><FeatureIcon name="preview" /></span>Preview before saving</dt><dd>Try unsaved changes in the app without recording. Live dictation can use a single-row caption strip instead.</dd></div>
      </dl>
      <a class="text-link" href={href("/docs/guides/using-freehand/#finding-and-adjusting-settings")}>Overlay settings →</a>
    </div>
    <OverlayExplorer />
  </section>
  <section class="feature-section" aria-labelledby="recording-title">
    <h2 id="recording-title">Recording controls</h2>
    <div class="feature-list">{recording.map(feature => <article><h3>{feature.title}</h3><p>{feature.description}</p><a class="text-link" href={href(feature.path)}>{feature.link} →</a></article>)}</div>
  </section>
  <section class="feature-section" aria-labelledby="results-title">
    <h2 id="results-title">Results & recovery</h2>
    <div class="feature-list">{results.map(feature => <article><h3>{feature.title}</h3><p>{feature.description}</p><a class="text-link" href={href(feature.path)}>{feature.link} →</a></article>)}</div>
  </section>
  <div class="feature-reference"><p>Model-specific controls and realtime availability depend on your selected model and backend.</p><a class="text-link" href={href("/models/")}>Model support →</a></div>
</ProductLayout>
<style>
  .overlay-feature { display: grid; grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding: 12px 0 44px; }
  .overlay-copy > p { color: var(--muted); font-size: 15px; line-height: 1.7; margin: 16px 0 22px; }
  dl { margin: 0 0 20px; }
  dl > div { position: relative; padding: 16px 0 16px 52px; border-top: 1px solid var(--line); }
  .overlay-setting-icon { position: absolute; top: 18px; left: 0; display: grid; place-items: center; width: 34px; height: 34px; color: var(--muted-strong); }
  dt { font-size: 14px; color: var(--ink); margin-bottom: 5px; }
  dd { margin: 0; font-size: 13px; color: var(--muted); line-height: 1.65; }
  .feature-section { padding: 34px 0; border-top: 1px solid var(--line); }
  .feature-section > h2 { margin-bottom: 26px; font-size: 25px; }
  .feature-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 36px; }
  .feature-list article { min-width: 0; display: flex; flex-direction: column; }
  .feature-list h3 { font-size: 18px; }
  .feature-list p { margin: 12px 0 16px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .feature-list .text-link { margin-top: auto; font-size: 13px; }
  .feature-reference { display: flex; gap: 16px 28px; align-items: baseline; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 20px; font-size: 12px; color: var(--muted); }
  .feature-reference p { margin: 0; }
  .feature-reference a { flex: none; }
  @media (max-width: 800px) {
    .overlay-feature { grid-template-columns: 1fr; gap: 28px; }
    .feature-list { grid-template-columns: 1fr; gap: 26px; }
    .feature-reference { flex-direction: column; gap: 8px; }
  }
</style>
