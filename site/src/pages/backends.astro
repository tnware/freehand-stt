---
import ProductLayout from "../layouts/ProductLayout.astro";
import ProviderIcon from "../components/ProviderIcon.astro";
import SupportIndicator from "../components/SupportIndicator.astro";
import { availableBackends, plannedBackends, features } from "../data/backends";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
const overview = [
  { key: "microphone", label: "Transcription" },
  { key: "realtime", label: "Live dictation" },
  { key: "cleanup", label: "Cleanup" },
  { key: "playback", label: "Speech" },
] as const;
---
<ProductLayout current="backends" title="Supported backends — Freehand" description="Compare Freehand server profiles for transcription, live dictation, transcript cleanup, and speech generation." path="backends/">
  <header class="page-heading"><h1>Supported backends</h1><p class="lede">Compare server profiles by capability. Setup guides cover connection details, server versions, and supported models.</p></header>
  <p class="catalog-note"><strong>Check your release.</strong> This catalog includes profiles that may not yet be in your installed version.</p>
  <freehand-backend-directory>
    <div class="catalog-toolbar" hidden>
      <label>Capability <select aria-label="Filter by capability"><option value="all">All capabilities</option>{overview.map((feature) => <option value={feature.key}>{feature.label}</option>)}</select></label>
      <input type="search" placeholder="Find a backend…" aria-label="Find a backend" />
    </div>
    <div class="catalog-scroll" role="region" aria-label="Backend comparison; scroll horizontally on small screens" tabindex="0">
      <table class="backend-table">
        <caption data-directory-status aria-live="polite">Available backend profiles</caption>
        <thead><tr><th scope="col">Backend</th>{overview.map((feature) => <th scope="col">{feature.label}</th>)}<th scope="col">Guide</th></tr></thead>
        <tbody>{availableBackends.map((backend) => <tr data-backend-name={backend.name.toLowerCase()} data-capabilities={overview.filter((feature) => backend.features[feature.key] === "available").map((feature) => feature.key).join(" ")}>
          <td><div class="backend-identity"><ProviderIcon profile={backend.id} size={42} /><div><strong>{backend.name}</strong><p>{backend.summary}</p></div></div></td>
          {overview.map((feature) => <td class="capability-cell"><SupportIndicator status={backend.features[feature.key]} /></td>)}
          <td><a class="text-link" href={href(backend.guide)} aria-label={`Set up ${backend.name}`}>Setup ↗</a></td>
        </tr>)}</tbody>
      </table>
      <p class="catalog-empty" hidden>No matching backends. Try another name or capability.</p>
    </div>
  </freehand-backend-directory>
  <div class="catalog-help"><p><strong>Support is profile-specific.</strong> The server version and model still determine what works. Live dictation requires an explicitly qualified model profile.</p><p><strong>Transcription includes Voice and audio files.</strong> Streamed file results are separate from live microphone dictation. <a class="text-link" href={href("/models/")}>Model profiles →</a></p></div>
  <details class="disclosure" id="compare"><summary>Detailed capability comparison</summary>
    <p>Language, vocabulary, cleanup, and voice-discovery support by backend. See the setup guide for model-specific restrictions.</p>
    <div class="catalog-scroll" role="region" aria-label="Detailed backend capabilities; scroll horizontally" tabindex="0"><table class="backend-table"><caption>Detailed backend profile capabilities</caption><thead><tr><th scope="col">Backend</th>{features.map((feature) => <th scope="col">{feature.label}</th>)}</tr></thead><tbody>{availableBackends.map((backend) => <tr><td><a class="backend-identity" href={href(backend.guide)}><ProviderIcon profile={backend.id} size={26} />{backend.name}</a></td>{features.map((feature) => <td class="capability-cell"><SupportIndicator status={backend.features[feature.key]} /></td>)}</tr>)}</tbody></table></div>
  </details>
  <details class="disclosure" id="planned"><summary>Planned dedicated profiles</summary><div class="planned-list">{plannedBackends.map((backend) => <article><div class="backend-identity"><ProviderIcon profile={backend.id} size={34} /><h3>{backend.name}</h3></div><p>{backend.summary}</p><a class="text-link" href={href(backend.guide)}>Planned scope →</a></article>)}</div><p>These dedicated profiles are not available. Some services may work through Generic OpenAI-compatible where their API matches that contract.</p></details>
  <a class="text-link" href={href("/docs/guides/connect-a-server/")}>Connection setup guide →</a>
  <script>
    class FreehandBackendDirectory extends HTMLElement {
      private listeners?: AbortController;
      connectedCallback() {
        this.listeners?.abort();
        this.listeners = new AbortController();
        const options = { signal: this.listeners.signal };
        const toolbar = this.querySelector<HTMLElement>(".catalog-toolbar");
        const select = this.querySelector("select");
        const search = this.querySelector("input");
        const status = this.querySelector("[data-directory-status]");
        const empty = this.querySelector<HTMLElement>(".catalog-empty");
        const rows = [...this.querySelectorAll<HTMLTableRowElement>("[data-backend-name]")];
        if (!toolbar || !select || !search || !status || !empty) return;
        toolbar.hidden = false;
        const filter = () => {
          const query = search.value.trim().toLowerCase();
          let visible = 0;
          for (const row of rows) {
            row.hidden = !(row.dataset.backendName?.includes(query) && (select.value === "all" || row.dataset.capabilities?.split(" ").includes(select.value)));
            if (!row.hidden) visible++;
          }
          status.textContent = `${visible} of ${rows.length} available profiles`;
          empty.hidden = visible > 0;
        };
        select.addEventListener("change", filter, options);
        search.addEventListener("input", filter, options);
        filter();
      }
      disconnectedCallback() { this.listeners?.abort(); }
    }
    if (!customElements.get("freehand-backend-directory")) customElements.define("freehand-backend-directory", FreehandBackendDirectory);
  </script>
</ProductLayout>
