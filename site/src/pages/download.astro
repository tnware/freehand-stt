---
import ProductLayout from "../layouts/ProductLayout.astro";
import mark from "../assets/freehand-mark.svg";
import { ASSETS, RELEASES_URL } from "../lib/downloads.mjs";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}${path}`;
---
<ProductLayout current="download" title="Download Freehand for Windows and macOS" description="Freehand for Windows 11 x64 and macOS 13+. Windows installer, portable, Apple Silicon, and Intel release availability." path="download/">
  <section class="download-intro" aria-labelledby="download-title">
    <div><p class="eyebrow">Windows & macOS</p><h1 id="download-title">Download Freehand</h1><p class="lede">Free and open source. Connect a compatible speech server or provider; models and inference runtimes are not bundled.</p><div class="actions"><a class="button" href="#all-downloads" data-primary-download>Choose your desktop build</a></div><p data-platform-message>Choose Windows, Apple Silicon, or Intel below. Not every release includes every platform.</p><p class="fine-print">Windows 11 x64 · macOS 13+<br />Your chosen provider or hosting may have its own costs.</p></div>
    <aside class="release-summary" aria-label="Latest release"><header><img src={mark.src} alt="" /><div><p>Latest public release</p><strong data-release-version>Check release availability</strong></div></header><div data-recommendation aria-label="Recommended downloads"></div><p class="release-status" data-release-status role="status">Availability has not been checked. Use GitHub Releases to see the actual files.</p><noscript><p class="fine-print">JavaScript is off. Platform links open GitHub Releases; choose a file actually listed there.</p></noscript><a class="text-link" href={RELEASES_URL}>Release notes & checksums ↗</a></aside>
  </section>
  <section id="all-downloads" class="download-options" aria-labelledby="platform-title"><h2 id="platform-title">Desktop builds</h2><div class="download-grid">{Object.entries(ASSETS).map(([key, asset]) => <article class="download-option"><h3>{asset.label}</h3><p>{asset.detail}</p><p>{key === "installer" ? "Recommended on Windows. Installs for your account with a Start Menu shortcut; no administrator access required." : key === "portable" ? "Keep the executable in a stable, user-writable folder. No shortcuts or uninstaller." : "Choose the ZIP matching your Mac. Ad-hoc signed, not notarized; read the setup guide before opening."}</p><a class="text-link" href={RELEASES_URL} data-asset={key}>{asset.label} — Check GitHub availability</a></article>)}</div></section>
  <section class="install-notes" aria-label="Installation notes"><article><h2>Installation & permissions</h2><p>Windows builds are unsigned. Mac builds are ad-hoc signed, not notarized. Follow the platform guide for installation and permissions.</p><a class="text-link" href={href("/docs/guides/windows-installer/")}>Windows installation →</a><br /><a class="text-link" href={href("/docs/guides/macos-setup/")}>macOS setup →</a></article><article><h2>Verify & connect</h2><p>Check SHA-256 against SHA256SUMS from the same release. After opening Freehand, configure the connection and model for the task you want to use.</p><a class="text-link" href={href("/docs/getting-started/")}>Setup guide →</a></article></section>
  <script>
    import { enhanceDownloads } from "../lib/downloads-client.mjs";
    enhanceDownloads();
  </script>
</ProductLayout>
