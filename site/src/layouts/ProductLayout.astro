---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CustomPageMetadata from "../components/CustomPageMetadata.astro";
import ParticleBackground from "../components/ParticleBackground.astro";
import "../styles/product.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  current?: "home" | "download" | "backends" | "models" | "privacy";
}
const { title, description, path = "", current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <CustomPageMetadata {title} {description} {path} />
    <meta name="theme-color" content="#070a12" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <ParticleBackground />
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader {current} />
    <main id="main" class="product-page"><slot /></main>
    <SiteFooter />
  </body>
</html>
